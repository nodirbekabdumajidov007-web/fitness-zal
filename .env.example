# Copy this file to ".env" (same folder as manage.py) and fill in what you use. ".env" is never sent to GitHub.
# On Render, put the same keys under Environment instead.


# E-mail (Gmail: smtp.gmail.com + an App Password, not your normal password)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Photos and videos in the cloud: cloudinary.com -> Dashboard -> API environment variable
CLOUDINARY_URL=

# Instagram Direct bot (docs/INSTAGRAM.md). All three are needed; leave empty to keep the feature off.
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
# Optional: our own Instagram user id (messages from it are ignored) and the Graph API version
IG_ACCOUNT_ID=
IG_API_VERSION=v27.0
